<extension xmlns="http://ns.adobe.com/air/extension/2.5"> 
	<id>SoundEngineExtension</id>
	<versionNumber>1.0.0</versionNumber>
	<platforms>
		<platform name="Windows-x86">
			<applicationDeployment>
				<nativeLibrary>SoundEngineExtension.dll</nativeLibrary>
				<initializer>SoundEngineExtInitializer</initializer>
				<finalizer>SoundEngineExtFinalizer</finalizer>
			</applicationDeployment>
		</platform>
		<platform name="Windows-x86-64">
			<applicationDeployment>
				<nativeLibrary>SoundEngineExtension.dll</nativeLibrary>
				<initializer>SoundEngineExtInitializer</initializer>
				<finalizer>SoundEngineExtFinalizer</finalizer>
			</applicationDeployment>
		</platform>
	</platforms>
</extension>